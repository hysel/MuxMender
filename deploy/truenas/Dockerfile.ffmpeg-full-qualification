# Workflow-feature qualification only; never a production image.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config nasm xz-utils xxd meson ninja-build python3-jinja2 zlib1g-dev libdav1d-dev libx264-dev libx265-dev libaom-dev libzimg-dev libass-dev libshaderc-dev libvulkan-dev nodejs && apt-get clean
COPY source/ /build/source/
WORKDIR /build
RUN sha256sum -c source/source.sha256 && tar -xf source/ffmpeg-9.0.2.tar.xz && tar -xf source/nv-codec-headers-n13.0.19.0.tar.gz && tar -xf source/vmaf-3.0.0.tar.gz && tar -xf source/libplacebo-7.351.0.tar.gz && tar -xf source/vulkan-headers-libplacebo.tar.gz -C libplacebo-7.351.0/3rdparty/Vulkan-Headers --strip-components=1 && make -C nv-codec-headers-n13.0.19.0 install
RUN command -v xxd && meson setup vmaf-3.0.0/libvmaf/build vmaf-3.0.0/libvmaf --prefix=/opt/ffmpeg9-deps --libdir=lib --buildtype=release -Dbuilt_in_models=true -Denable_tests=false -Denable_docs=false && ninja -C vmaf-3.0.0/libvmaf/build -j2 && ninja -C vmaf-3.0.0/libvmaf/build install
ENV PKG_CONFIG_PATH=/opt/ffmpeg9-deps/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
ENV LD_LIBRARY_PATH=/opt/ffmpeg9-deps/lib:/usr/lib/x86_64-linux-gnu
RUN meson setup libplacebo-7.351.0/build libplacebo-7.351.0 --prefix=/opt/ffmpeg9-deps --libdir=lib --buildtype=release -Dvulkan=enabled -Dshaderc=enabled -Dglslang=disabled -Dopengl=disabled -Ddemos=false -Dtests=false -Dlibdovi=disabled && ninja -C libplacebo-7.351.0/build -j2 && ninja -C libplacebo-7.351.0/build install
RUN mkdir -p /opt/ffmpeg9-deps/include && cp -r libplacebo-7.351.0/3rdparty/Vulkan-Headers/include/. /opt/ffmpeg9-deps/include/
WORKDIR /build/ffmpeg-9.0.2
RUN ./configure --prefix=/opt/ffmpeg9 --disable-autodetect --disable-doc --disable-debug --disable-ffplay --disable-network --enable-gpl --enable-version3 --enable-pthreads --enable-zlib --enable-libdav1d --enable-libx264 --enable-libx265 --enable-libaom --enable-libvmaf --enable-libzimg --enable-libass --enable-libplacebo --enable-vulkan --enable-ffnvcodec --enable-nvenc --enable-nvdec --enable-cuvid --enable-cuda --extra-cflags='-I/opt/ffmpeg9-deps/include' --extra-ldflags='-L/opt/ffmpeg9-deps/lib -L/usr/lib/x86_64-linux-gnu -Wl,-rpath,/opt/ffmpeg9-deps/lib' && make -j2 && make install
RUN /opt/ffmpeg9/bin/ffmpeg -v error -nostdin -f lavfi -i 'testsrc2=size=192x108:rate=2:duration=1' -filter_complex '[0:v]split[a][b];[a][b]libvmaf=n_threads=2' -f null -
COPY tools/patch_cuda_ffprobe.py /build/patch_cuda_ffprobe.py
RUN python3 /build/patch_cuda_ffprobe.py fftools/ffprobe.c --decoder libavcodec/hevc/hevcdec.c --nvdec libavcodec/nvdec.c --av1 && make -j2 ffprobe && mkdir -p /opt/ffmpeg9-reader && cp ffprobe /opt/ffmpeg9-reader/ffprobe-cuda
COPY python/ /opt/qualification/python/
COPY tests/ /opt/qualification/tests/
COPY tools/ /opt/qualification/tools/
COPY docs/ /opt/qualification/docs/
COPY deploy/ /opt/qualification/deploy/
COPY AGENTS.md README.md pyproject.toml /opt/qualification/
RUN mkdir -p /opt/qualification/runtime && python3 -m pip install --no-deps --target /opt/qualification/runtime /build/source/av-19.0.0-cp312-abi3-manylinux_2_28_x86_64.whl && dpkg-query -W > /opt/qualification/build-packages.txt
ENV PYTHONPATH=/opt/qualification/python:/opt/qualification/runtime PYTHONDONTWRITEBYTECODE=1
USER 3005:3005
ENTRYPOINT ["python3", "-B", "/opt/qualification/tools/qualify_ffmpeg_full.py"]
