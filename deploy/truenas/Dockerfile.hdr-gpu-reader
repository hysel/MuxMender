# Isolated build tool only: does not replace the app or install host packages.
FROM ubuntu:24.04 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config nasm python3 xz-utils zlib1g-dev ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY ffmpeg-9.0.2.tar.xz nv-codec-headers-n13.0.19.0.tar.gz ./
RUN echo '8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e  ffmpeg-9.0.2.tar.xz' | sha256sum -c - && echo '86d15d1a7c0ac73a0eafdfc57bebfeba7da8264595bf531cf4d8db1c22940116  nv-codec-headers-n13.0.19.0.tar.gz' | sha256sum -c - && tar -xf ffmpeg-9.0.2.tar.xz && tar -xf nv-codec-headers-n13.0.19.0.tar.gz && make -C nv-codec-headers-n13.0.19.0 install
COPY patch_cuda_ffprobe.py ./
RUN python3 patch_cuda_ffprobe.py ffmpeg-9.0.2/fftools/ffprobe.c --decoder ffmpeg-9.0.2/libavcodec/hevc/hevcdec.c --nvdec ffmpeg-9.0.2/libavcodec/nvdec.c --av1
WORKDIR /build/ffmpeg-9.0.2
RUN ./configure --disable-autodetect --disable-everything --disable-doc --disable-debug --disable-network --disable-ffmpeg --disable-ffplay --enable-ffprobe --enable-pthreads --enable-zlib --enable-ffnvcodec --enable-nvdec --enable-cuda --enable-hwaccel=hevc_nvdec,av1_nvdec --enable-decoder=hevc,av1 --enable-parser=hevc,av1 --enable-demuxer=matroska,mov,mpegts,hevc,obu --enable-protocol=file,pipe && make -j2 ffprobe
RUN mkdir -p /export/bin /export/source && cp ffprobe /export/bin/ffprobe-cuda && chmod 755 /export/bin/ffprobe-cuda && cp /build/ffmpeg-9.0.2.tar.xz /build/patch_cuda_ffprobe.py LICENSE.md COPYING.LGPLv2.1 /export/source/
FROM scratch AS export
COPY --from=builder /export/ /
