{
  "name": "muxmender-vscode",
  "displayName": "MuxMender",
  "description": "Run safe MuxMender dry-run scans in a dedicated VS Code Output channel.",
  "version": "0.4.0",
  "publisher": "hysel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hysel/MuxMender.git"
  },
  "files": [
    "extension.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:muxmender.scanFolder",
    "onCommand:muxmender.optimizeFile",
    "onUri"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "muxmender.scanFolder",
        "title": "MuxMender: Scan Media Folder (Dry Run)"
      },
      {
        "command": "muxmender.optimizeFile",
        "title": "MuxMender: Optimize Selected Media File (Safe Copy)"
      }
    ],
    "configuration": {
      "title": "MuxMender",
      "properties": {
        "muxmender.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to run MuxMender."
        },
        "muxmender.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to muxmender.py. The active workspace is searched when empty."
        },
        "muxmender.hardware": {
          "type": "string",
          "enum": ["auto", "amd", "nvidia", "intel", "cpu"],
          "default": "auto",
          "enumDescriptions": [
            "Prefer a detected GPU and offer CPU if it fails.",
            "Require AMD AMF hardware encoding.",
            "Require NVIDIA NVENC hardware encoding.",
            "Require Intel Quick Sync hardware encoding.",
            "Use software encoding only."
          ],
          "description": "Video encoder hardware preference."
        },
        "muxmender.resolution": {
          "type": "string",
          "enum": ["keep", "2160p", "1080p", "720p", "480p"],
          "default": "keep",
          "enumDescriptions": [
            "Preserve every source video's exact dimensions.",
            "Downscale only videos larger than 3840x2160.",
            "Downscale only videos larger than 1920x1080.",
            "Downscale only videos larger than 1280x720.",
            "Downscale only videos larger than 854x480."
          ],
          "description": "Resolution policy. Preserves aspect ratio and never upscales."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
